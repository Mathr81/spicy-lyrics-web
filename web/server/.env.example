# Copy to `.env` (never commit it) and fill in SP_DC.

# Your Spotify `sp_dc` cookie. The proxy mints a web-player token from it
# server-side, which is what unlocks *synced* lyrics; without it you still get
# plain text. To find it: log in to open.spotify.com, DevTools → Application →
# Cookies → https://open.spotify.com → sp_dc. It is account-scoped and
# long-lived: treat it like a password, and re-copy it if synced lyrics stop.
SP_DC=

# The reverse proxy's Docker network, which the container joins so Nginx Proxy
# Manager can reach it as `spicy-lyrics-proxy:8787`. No port is published on the
# host. Docker names that network after the directory holding the reverse
# proxy's compose file — `docker network ls` shows yours.
#PROXY_NETWORK=npm_default

# debug | info | warn | error | silent. `debug` also logs cache hits and
# per-device session ops, which is how you check devices really are collapsing
# into one upstream client.
#LOG_LEVEL=info

# Send the proxy's own outbound traffic through a SOCKS5/CONNECT proxy.
# Inside a container 127.0.0.1 is the container itself, so to reach a tunnel on
# the host use host.docker.internal and add to the service in compose.yaml:
#   extra_hosts: ["host.docker.internal:host-gateway"]
#PROXY_URL=socks5://host.docker.internal:1080

# Tunables — all optional, defaults are in proxy.mjs.
#CLIENT_VERSION=6.3.20
#LYRICS_CACHE_TTL=604800
#LYRICS_MISS_CACHE_TTL=3600
#CLIENT_PING_INTERVAL_MS=900000
#CLIENT_SESSION_TTL_S=86400
#SESSION_IDLE_MS=1800000
