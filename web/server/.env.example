# Copy to `.env` (never commit it) and fill in SP_DC.

# Your Spotify `sp_dc` cookie. The proxy mints a web-player token from it
# server-side, which is what unlocks *synced* lyrics; without it you still get
# plain text. To find it: log in to open.spotify.com, DevTools → Application →
# Cookies → https://open.spotify.com → sp_dc. It is account-scoped and
# long-lived: treat it like a password, and re-copy it if synced lyrics stop.
SP_DC=

# The port the proxy listens on inside the container. The server, the Docker
# healthcheck and compose's `expose` all follow it, so this one line is the whole
# change — then set the same number as NPM's Forward Port. Nothing is published
# on the host, so 8787 can only collide with another container on the reverse
# proxy's network, never with something on the machine.
#PORT=8987

# The reverse proxy's Docker network, which the container joins so Nginx Proxy
# Manager can reach it as `spicy-lyrics-proxy:8787`. No port is published on the
# host. Docker names that network after the directory holding the reverse
# proxy's compose file — `docker network ls` shows yours.
#PROXY_NETWORK=npm_default

# debug | info | warn | error | silent. `debug` also logs cache hits and
# per-device session ops, which is how you check devices really are collapsing
# into one upstream client.
#LOG_LEVEL=info

# Send the proxy's own outbound traffic through a SOCKS5/CONNECT proxy — the way
# out when the API challenges this machine's address (see web/README.md).
#
# Inside a container 127.0.0.1 is the container itself, so a tunnel on the host
# needs a reachable address:
#
#  - Tunnel in Docker (simplest): put it on the same network as this container
#    and use its container name.        PROXY_URL=socks5://my-tunnel:1080
#
#  - Tunnel on the host: use the gateway of THIS container's network, and make
#    the tunnel listen on it (a tunnel bound to 127.0.0.1 is unreachable from
#    any container). Find the address with:
#      docker network inspect npm_default -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
#                                          PROXY_URL=socks5://172.18.0.1:1080
#
#    `host.docker.internal:host-gateway` is NOT the answer here: it resolves to
#    the default bridge's gateway (172.17.0.1), which a container on a
#    user-defined network has no route to — EHOSTUNREACH.
#PROXY_URL=socks5://172.18.0.1:1080

# Tunables — all optional, defaults are in proxy.mjs.
#CLIENT_VERSION=6.3.20
#LYRICS_CACHE_TTL=604800
#LYRICS_MISS_CACHE_TTL=3600
#CLIENT_PING_INTERVAL_MS=900000
#CLIENT_SESSION_TTL_S=86400
#SESSION_IDLE_MS=1800000
