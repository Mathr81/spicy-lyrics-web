# Copy to .env (which is gitignored) and edit.
#   cd web/server && cp .env.example .env

# Your Spotify sp_dc cookie — required for SYNCED lyrics.
# open.spotify.com → DevTools → Application → Cookies → sp_dc.
# Treat it like a password. Long-lived (months); if lyrics go back to plain
# text, it has expired.
SP_DC=

# Port published on the host. The container always listens on 8787.
HOST_PORT=8787

# Route the proxy's own outbound requests through another proxy.
# Inside a container 127.0.0.1 is the container — use host.docker.internal.
# PROXY_URL=socks5://host.docker.internal:1080

# debug | info | warn | error | silent
LOG_LEVEL=info
