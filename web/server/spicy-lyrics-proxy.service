# systemd unit for a VPS or home server.
#
#   sudo cp spicy-lyrics-proxy.service /etc/systemd/system/
#   sudo systemctl edit spicy-lyrics-proxy    # add: [Service] \n Environment=SP_DC=...
#   sudo systemctl enable --now spicy-lyrics-proxy
#
# Put the cookie in the drop-in (or an EnvironmentFile with mode 600), never in
# this file — it is world-readable in /etc/systemd/system.

[Unit]
Description=Spicy Lyrics API proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node %h/spicy-lyrics-web/web/server/server.mjs
Environment=PORT=8787
Environment=STATE_DIR=%S/spicy-lyrics-proxy
# Route this service's own outbound requests through a proxy, e.g. a local
# SOCKS5 tunnel. Omit for a direct connection.
# Environment=PROXY_URL=socks5://127.0.0.1:1080
# Environment=SP_DC=...        <- put this in a drop-in, not here
StateDirectory=spicy-lyrics-proxy
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
