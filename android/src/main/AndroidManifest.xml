<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The self-updater (MainActivity): install its own next version, without a
         confirmation once it is the one that installed the current one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:icon="@mipmap/icon"
        android:label="Spicy Lyrics"
        android:theme="@style/App">
        <!-- configChanges: neither a rotation nor shrinking to picture-in-picture
             may rebuild the activity, which would reload the page mid-song.
             singleTop: install results arrive in onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- See MediaLink.java: the permission Android asks of whoever reads
             another app's media session. -->
        <service
            android:name=".MediaLink"
            android:exported="true"
            android:label="Spicy Lyrics"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
